# Server-only. Never prefix with VITE_. Read via process.env inside server handlers.
# Optional – enables AI-enriched guidance (Google Gemini). Without it, rule-based guidance is served.
GEMINI_API_KEY=
# Optional – override the Gemini model. Defaults to gemini-3.5-flash-lite if unset.
# Must be a model that supports responseMimeType: "application/json" structured output.
GEMINI_MODEL=
# Optional – WAQI ground-station feed (https://aqicn.org/data-platform/token/). Never cached.
WAQI_API_TOKEN=
# Optional – CPCB real-time feed via data.gov.in OGD (https://data.gov.in → My Account → API key).
DATA_GOV_IN_API_KEY=
# Optional – comma-separated extra origins allowed to call /api/public/*. Same-origin is always allowed.
ALLOWED_ORIGINS=
